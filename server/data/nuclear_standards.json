  {
    "id": "N-005",
    "type": "nuclear",
    "documentName": "核电工程现场文明施工管理规范（演示）",
    "documentCode": "DEMO-N-005",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-12",
    "category": "文明施工",
    "clauses": [
      {
        "id": "N-005-4.1.1",
        "clause": "4.1.1",
        "clauseTitle": "5S 定置管理",
        "content": "核电现场推行 5S 管理，材料、机具分类定置摆放并设置清晰标识，保持现场整洁。",
        "category": "文明施工",
        "keywords": ["5S", "定置", "堆放", "标识", "核电", "整洁"]
      },
      {
        "id": "N-005-4.3.2",
        "clause": "4.3.2",
        "clauseTitle": "场地排水与防滑",
        "content": "施工作业面及通道应保持排水通畅，无积水、无油污，防止滑倒及液体流入设备区域。",
        "category": "文明施工",
        "keywords": ["积水", "油污", "液体", "排水", "滑倒"]
      },
      {
        "id": "N-005-5.1.3",
        "clause": "5.1.3",
        "clauseTitle": "相邻区域隔离",
        "content": "与重要工作区域（如核岛、仪控间）相邻的施工面应设置隔离与警示，防止异物侵入。",
        "category": "文明施工",
        "keywords": ["核岛", "隔离", "警示", "异物"]
      }
    ]
  },
  {
    "id": "N-006",
    "type": "nuclear",
    "documentName": "核电工程安全隐患分级标准（演示）",
    "documentCode": "DEMO-N-006",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-12",
    "category": "定级",
    "clauses": [
      {
        "id": "N-006-3.1.1",
        "clause": "3.1.1",
        "clauseTitle": "A 级重大隐患",
        "content": "重大隐患（A级）：可能引发群死群伤或影响核安全设备运行的隐患，应立即停工并立即组织整改。",
        "category": "定级",
        "keywords": ["A级", "重大隐患", "停工", "群死群伤", "核安全"]
      },
      {
        "id": "N-006-3.1.2",
        "clause": "3.1.2",
        "clauseTitle": "B 级较大隐患",
        "content": "较大隐患（B级）：可能导致人员严重伤害或设备重大损坏的隐患，应优先整改，必要时停止相关作业。",
        "category": "定级",
        "keywords": ["B级", "较大隐患", "优先整改"]
      },
      {
        "id": "N-006-3.1.3",
        "clause": "3.1.3",
        "clauseTitle": "C 级一般隐患",
        "content": "一般隐患（C级）：存在明确不符合项、但风险可控的隐患，应限期整改。",
        "category": "定级",
        "keywords": ["C级", "一般隐患", "限期整改"]
      },
      {
        "id": "N-006-3.1.4",
        "clause": "3.1.4",
        "clauseTitle": "D 级轻微隐患",
        "content": "轻微隐患（D级）：管理或文明施工类问题，短期不会造成严重事故，可通过现场纠正解决。",
        "category": "定级",
        "keywords": ["D级", "轻微隐患", "文明施工", "现场纠正"]
      },
      {
        "id": "N-006-3.2.1",
        "clause": "3.2.1",
        "clauseTitle": "风险值辅助定级",
        "content": "隐患定级应综合考虑严重度、可能性及事故后果，可按风险值＝严重度×可能性 进行辅助计算。",
        "category": "定级",
        "keywords": ["风险值", "定级", "严重度", "可能性"]
      }
    ]
  }
