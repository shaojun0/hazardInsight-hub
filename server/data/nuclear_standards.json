    "documentName": "核电工程高风险作业管理标准（演示）",
    "documentCode": "DEMO-N-002",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-12",
    "category": "高风险作业",
    "clauses": [
      {
        "id": "N-002-4.2.1",
        "clause": "4.2.1",
        "clauseTitle": "高风险作业许可",
        "content": "核电现场的高空、临边、起重吊装、动火、受限空间等高风险作业实行作业许可证制度。",
        "category": "高风险作业",
        "keywords": ["高风险", "作业许可", "吊装", "动火", "核电"]
      },
      {
        "id": "N-002-4.4.3",
        "clause": "4.4.3",
        "clauseTitle": "作业监护",
        "content": "高风险作业应设置专职监护人员，作业期间监护人不得离岗，并持续监控风险变化。",
        "category": "高风险作业",
        "keywords": ["监护", "高风险", "作业"]
      },
      {
        "id": "N-002-5.1.2",
        "clause": "5.1.2",
        "clauseTitle": "核安全设备防坠考虑",
        "content": "在核安全相关设备附近进行高处作业时，应评估工具、材料坠落对设备安全的潜在影响并采取防护措施。",
        "category": "高处作业",
        "keywords": ["坠落", "核安全", "高处作业", "防坠"]
      }
    ]
  },
  {
    "id": "N-003",
