    "clauses": [
      {
        "id": "N-003-5.3.2",
        "clause": "5.3.2",
        "clauseTitle": "移动插座负载配置",
        "content": "移动插座应根据设备负载合理配置，核电现场施工用电应采用专用回路，严禁私拉乱接和超负荷共用。",
        "category": "临时用电",
        "keywords": ["插排", "移动插座", "过载", "专用回路", "核电", "负载"]
      },
      {
        "id": "N-003-5.5.1",
        "clause": "5.5.1",
        "clauseTitle": "设备密集区域用电安全",
        "content": "核岛等设备密集区域施工用电，电源线缆应与重要设备、仪表保持安全距离，并采取抗机械损伤防护措施。",
        "category": "临时用电",
        "keywords": ["核岛", "电缆", "电源线", "防损伤", "仪表"]
      },
      {
        "id": "N-003-6.1.3",
        "clause": "6.1.3",
        "clauseTitle": "潮湿环境用电",
        "content": "潮湿环境及金属构架附近作业应提高用电防护等级，使用安全电压或隔离变压器。",
        "category": "临时用电",
        "keywords": ["潮湿", "安全电压", "隔离变压器", "触电"]
      },
      {
        "id": "N-003-6.2.4",
        "clause": "6.2.4",
        "clauseTitle": "巡检与整改",
        "content": "临时用电设施应纳入核电现场定期巡检，发现发热、绝缘老化等问题立即组织整改并复验。",
        "category": "临时用电",
        "keywords": ["巡检", "发热", "绝缘", "整改", "核电"]
      }
    ]
  },
