[
  {
    "id": "N-001",
    "type": "nuclear",
    "documentName": "核电工程施工安全管理规定（演示）",
    "documentCode": "DEMO-N-001",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-12",
    "category": "综合",
    "clauses": [
      {
        "id": "N-001-4.1.1",
        "clause": "4.1.1",
        "clauseTitle": "全员安全生产责任制",
        "content": "核电工程施工应建立全员安全生产责任制，重大风险作业实行提级管理，风险控制措施应书面审批。",
        "category": "综合",
        "keywords": ["核电", "责任制", "重大风险", "提级管理"]
      },
      {
        "id": "N-001-4.3.2",
        "clause": "4.3.2",
        "clauseTitle": "核安全相关区域管理",
        "content": "涉及核安全相关设备、区域的施工活动，其安全管理要求不得低于通用标准，并应执行核电专项程序。",
        "category": "综合",
        "keywords": ["核安全", "核岛", "核电", "专项程序"]
      },
      {
        "id": "N-001-5.2.1",
        "clause": "5.2.1",
        "clauseTitle": "隐患闭环管理",
        "content": "核电工程隐患排查治理应遵循闭环管理，每项隐患均需明确责任、措施、时限，整改完成经验证后销号。",
        "category": "综合",
        "keywords": ["隐患", "闭环", "整改", "销号", "核电"]
      }
    ]
  },
  {
