    "documentName": "项目现场安全隐患排查治理管理办法（演示）",
    "documentCode": "DEMO-E-001",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-15",
    "category": "综合",
    "clauses": [
      {
        "id": "E-001-3.2.1",
        "clause": "3.2.1",
        "clauseTitle": "排查闭环流程",
        "content": "隐患按周开展排查，执行排查、登记、整改、复查、销号的闭环台账管理，责任到人。",
        "category": "综合",
        "keywords": ["隐患", "排查", "闭环", "台账", "整改", "销号"]
      },
      {
        "id": "E-001-4.1.3",
        "clause": "4.1.3",
        "clauseTitle": "重大隐患处置",
        "content": "发现重大隐患应立即上报并停止相关作业，整改完成经验收合格后方可复工。",
        "category": "综合",
        "keywords": ["重大隐患", "停工", "上报", "复工"]
      }
    ]
  },
  {
    "id": "E-002",
    "type": "enterprise",
    "documentName": "施工现场临时用电检查细则（演示）",
    "documentCode": "DEMO-E-002",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-15",
    "category": "临时用电",
    "clauses": [
      {
        "id": "E-002-4.2.3",
        "clause": "4.2.3",
        "clauseTitle": "插排负载检查",
        "content": "检查插排容量是否与负载匹配，禁止大功率设备共用同一插排；检查插排外观、发热情况及线缆是否老化破损。",
        "category": "临时用电",
        "keywords": ["插排", "过载", "大功率", "发热", "老化"]
      },
      {
        "id": "E-002-4.2.5",
        "clause": "4.2.5",
        "clauseTitle": "液体防护检查",
        "content": "用电设备及插排附近严禁放置水瓶、水杯等液体容器，防止液体倾倒造成短路或触电。",
        "category": "临时用电",
        "keywords": ["液体", "水瓶", "水杯", "插排", "短路", "触电"]
      },
      {
        "id": "E-002-5.1.2",
        "clause": "5.1.2",
        "clauseTitle": "电工专业检查",
        "content": "临时用电检查应由专业电工执行，检查结果形成记录并归档备案。",
        "category": "临时用电",
        "keywords": ["电工", "专业检查", "记录"]
      }
    ]
  },
  {
