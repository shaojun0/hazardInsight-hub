[
  {
    "id": "G-001",
    "type": "general",
    "documentName": "施工现场临时用电安全管理规范（演示）",
    "documentCode": "DEMO-G-001",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "临时用电",
    "clauses": [
      {
        "id": "G-001-5.1.1",
        "clause": "5.1.1",
        "clauseTitle": "配电系统总体要求",
        "content": "施工现场临时用电应实行三级配电、两级漏电保护，各类用电设备应有专人管理，线路敷设应满足安全要求。",
        "category": "临时用电",
        "keywords": ["临时用电", "配电", "漏电保护", "线路"]
      },
      {
        "id": "G-001-5.2.3",
        "clause": "5.2.3",
        "clauseTitle": "插座及移动用电设备管理",
        "content": "移动插座不得超负荷使用，用电线路应保持整洁并避免机械损伤；插排及接线板应选用合格产品并固定在安全位置。",
        "category": "临时用电",
        "keywords": ["插排", "移动插座", "超负荷", "线路", "接线板", "插座"]
      },
      {
        "id": "G-001-5.3.2",
        "clause": "5.3.2",
        "clauseTitle": "移动插座负载配置",
        "content": "移动插座应根据设备负载合理配置，不得将多个大功率设备集中接入同一回路，避免线路过载发热。",
        "category": "临时用电",
        "keywords": ["过载", "负载", "大功率", "同一回路", "发热"]
      },
      {
        "id": "G-001-5.4.1",
        "clause": "5.4.1",
        "clauseTitle": "电源线敷设",
        "content": "电源线应采取穿管、桥架等防护措施敷设，不得直接拖于地面或跨越人行通道、通道，不得与易燃物混放。",
        "category": "临时用电",
        "keywords": ["电源线", "电缆", "敷设", "通道", "拖地", "缠绕"]
      },
      {
        "id": "G-001-6.1.2",
        "clause": "6.1.2",
        "clauseTitle": "配电箱设置",
        "content": "配电箱应设置漏电保护装置，箱体防雨防潮，箱门完好并设置警示标识，周围不得堆放杂物。",
        "category": "临时用电",
        "keywords": ["配电箱", "漏电保护", "警示", "箱门"]
      },
      {
        "id": "G-001-6.2.4",
        "clause": "6.2.4",
        "clauseTitle": "用电管理责任",
        "content": "施工现场临时用电应由持证电工负责安装、巡检与维护，发现线路发热、绝缘破损应及时处理。",
        "category": "临时用电",
        "keywords": ["电工", "巡检", "绝缘", "发热"]
      }
    ]
  },
  {
    "id": "G-002",
    "type": "general",
    "documentName": "建筑施工安全检查标准（演示）",
    "documentCode": "DEMO-G-002",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "综合",
    "clauses": [
      {
        "id": "G-002-4.0.1",
        "clause": "4.0.1",
        "clauseTitle": "隐患排查闭环",
        "content": "施工现场应定期开展安全检查，对发现的隐患应建立台账并落实整改责任、措施和时限，形成闭环管理。",
        "category": "综合",
        "keywords": ["隐患", "台账", "整改", "闭环", "检查"]
      },
      {
        "id": "G-002-4.0.2",
        "clause": "4.0.2",
        "clauseTitle": "安全防护设施",
        "content": "临边、洞口、安全通道等安全防护设施应完好有效，严禁随意拆除或挪用。",
        "category": "综合",
        "keywords": ["临边", "洞口", "防护", "通道"]
      },
      {
        "id": "G-002-5.0.3",
        "clause": "5.0.3",
        "clauseTitle": "机械设备管理",
        "content": "各类施工机械、工器具应经检验合格后使用，安全防护装置齐全有效。",
        "category": "设备防护",
        "keywords": ["机械", "工器具", "防护装置", "检验"]
      },
      {
        "id": "G-002-6.0.1",
        "clause": "6.0.1",
        "clauseTitle": "现场通道管理",
        "content": "施工现场应保持安全通道、消防通道及疏散通道畅通，严禁占用、堵塞或堆放杂物。",
        "category": "文明施工",
        "keywords": ["通道", "消防通道", "堵塞", "畅通", "杂物"]
      }
    ]
  },
  {
    "id": "G-003",
    "type": "general",
    "documentName": "高处作业安全管理规定（演示）",
    "documentCode": "DEMO-G-003",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "高处作业",
    "clauses": [
      {
        "id": "G-003-5.1.2",
        "clause": "5.1.2",
        "clauseTitle": "安全带使用",
        "content": "凡在坠落高度基准面 2m 及以上进行作业，必须正确佩戴使用安全带并挂设在可靠锚点，做到高挂低用。",
        "category": "高处作业",
        "keywords": ["安全带", "高处作业", "2米", "坠落", "高挂低用"]
      },
      {
        "id": "G-003-5.2.3",
        "clause": "5.2.3",
        "clauseTitle": "高处作业行为",
        "content": "高处作业人员应穿防滑鞋，工器具应系挂防坠，严禁高处抛物。",
        "category": "高处作业",
        "keywords": ["防坠", "抛物", "高处作业", "工器具"]
      },
      {
        "id": "G-003-5.3.1",
        "clause": "5.3.1",
        "clauseTitle": "作业平台防护",
        "content": "高处作业平台、操作平台及走道的临边应设置高度不低于 1.2m 的防护栏杆并设置挡脚板。",
        "category": "临边洞口",
        "keywords": ["平台", "临边", "防护栏杆", "挡脚板"]
      },
      {
        "id": "G-003-6.0.1",
        "clause": "6.0.1",
        "clauseTitle": "作业区域警戒",
        "content": "高处作业区域下方应设置警戒区，必要时设置安全网，防止落物伤人。",
        "category": "高处作业",
        "keywords": ["警戒", "安全网", "落物", "高处作业"]
      }
    ]
  },
  {
    "id": "G-004",
    "type": "general",
    "documentName": "起重吊装安全管理规定（演示）",
    "documentCode": "DEMO-G-004",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "起重吊装",
    "clauses": [
      {
        "id": "G-004-5.1.1",
        "clause": "5.1.1",
        "clauseTitle": "吊装作业前检查",
        "content": "起重机械作业前应进行例行检查，确认制动、限位、钢丝绳、吊索具等安全装置完好。",
        "category": "起重吊装",
        "keywords": ["起重", "吊装", "钢丝绳", "吊索", "检查", "吊带"]
      },
      {
        "id": "G-004-5.2.3",
        "clause": "5.2.3",
        "clauseTitle": "吊装警戒与指挥",
        "content": "吊装作业应设专人指挥并划定警戒区域，严禁人员在吊物下方停留、通过或作业。",
        "category": "起重吊装",
        "keywords": ["吊物", "警戒", "指挥", "吊装", "起重"]
      },
      {
        "id": "G-004-5.3.2",
        "clause": "5.3.2",
        "clauseTitle": "吊装技术规范",
        "content": "吊物应捆绑牢固、吊点设置合理，严禁斜吊、超载吊装。",
        "category": "起重吊装",
        "keywords": ["捆绑", "超载", "斜吊", "吊点", "吊装"]
      },
      {
        "id": "G-004-6.1.2",
        "clause": "6.1.2",
        "clauseTitle": "作业环境限制",
        "content": "六级及以上大风或雷雨等恶劣天气应停止露天起重吊装作业。",
        "category": "起重吊装",
        "keywords": ["大风", "恶劣天气", "起重", "吊装"]
      }
    ]
  },
  {
    "id": "G-005",
    "type": "general",
    "documentName": "消防安全管理规定（演示）",
    "documentCode": "DEMO-G-005",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "消防",
    "clauses": [
      {
        "id": "G-005-5.1.1",
        "clause": "5.1.1",
        "clauseTitle": "消防器材配置",
        "content": "施工现场应配备足量、有效的灭火器材，并设置在明显、易取的位置，定期检查并在有效期内。",
        "category": "消防",
        "keywords": ["灭火器", "消防", "器材", "过期"]
      },
      {
        "id": "G-005-5.2.3",
        "clause": "5.2.3",
        "clauseTitle": "动火作业管理",
        "content": "动火作业应办理动火审批手续，作业前清理周围可燃物，设置看火人并配备灭火器材。",
        "category": "动火作业",
        "keywords": ["动火", "焊接", "气割", "看火", "可燃物", "审批"]
      },
      {
        "id": "G-005-5.3.2",
        "clause": "5.3.2",
        "clauseTitle": "易燃易爆品管理",
        "content": "易燃易爆物品应分类存放并远离火源、热源及电气设备，存放区设置警示标识。",
        "category": "消防",
        "keywords": ["易燃", "易燃物", "油", "溶剂", "火源", "存放"]
      },
      {
        "id": "G-005-6.0.2",
        "clause": "6.0.2",
        "clauseTitle": "电气火灾预防",
        "content": "电气线路短路、过载是引发火灾的重要原因，现场应防止私拉乱接、超负荷用电并及时清理可燃物。",
        "category": "消防",
        "keywords": ["火灾", "过载", "线路", "可燃物", "短路"]
      }
    ]
  },
  {
    "id": "G-006",
    "type": "general",
    "documentName": "劳动防护用品（PPE）管理规范（演示）",
    "documentCode": "DEMO-G-006",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "PPE",
    "clauses": [
      {
        "id": "G-006-5.1.2",
        "clause": "5.1.2",
        "clauseTitle": "安全帽佩戴",
        "content": "进入施工现场的作业人员必须正确佩戴安全帽，帽衬与帽壳贴合，并系好下颚带。",
        "category": "PPE",
        "keywords": ["安全帽", "PPE", "佩戴", "下颚带"]
      },
      {
        "id": "G-006-5.2.3",
        "clause": "5.2.3",
        "clauseTitle": "安全带使用",
        "content": "从事高处作业、临边作业的人员必须使用符合要求的安全带并高挂低用。",
        "category": "PPE",
        "keywords": ["安全带", "高处作业", "PPE"]
      },
      {
        "id": "G-006-5.3.1",
        "clause": "5.3.1",
        "clauseTitle": "岗位防护用品",
        "content": "作业人员应根据岗位要求配备防砸、防电、防尘、防毒、防护面罩等个人防护用品。",
        "category": "PPE",
        "keywords": ["防护面罩", "手套", "绝缘", "防护用品", "PPE", "焊接"]
      },
      {
        "id": "G-006-6.0.2",
        "clause": "6.0.2",
        "clauseTitle": "PPE 完好性检查",
        "content": "个人防护用品使用前应检查完好性，破损、失效或超期的用品不得继续使用。",
        "category": "PPE",
        "keywords": ["PPE", "破损", "检查", "防护用品"]
      }
    ]
  },
  {
    "id": "G-007",
    "type": "general",
    "documentName": "文明施工与现场卫生管理规范（演示）",
    "documentCode": "DEMO-G-007",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "文明施工",
    "clauses": [
      {
        "id": "G-007-5.1.1",
        "clause": "5.1.1",
        "clauseTitle": "材料堆放管理",
        "content": "现场材料、构件、工器具应按总平面布置分类码放整齐并设置标识，堆放高度与稳定性应满足要求。",
        "category": "材料堆放",
        "keywords": ["材料", "堆放", "码放", "分类", "标识"]
      },
      {
        "id": "G-007-5.2.2",
        "clause": "5.2.2",
        "clauseTitle": "通道畅通",
        "content": "安全通道、消防通道及人行通道应保持畅通，严禁堆放杂物、材料和工器具。",
        "category": "文明施工",
        "keywords": ["通道", "畅通", "杂物", "堵塞"]
      },
      {
        "id": "G-007-5.3.1",
        "clause": "5.3.1",
        "clauseTitle": "现场清洁",
        "content": "施工现场应保持整洁有序，及时清理建筑垃圾、废弃物和油污积水。",
        "category": "文明施工",
        "keywords": ["清洁", "垃圾", "油污", "积水", "整洁"]
      },
      {
        "id": "G-007-5.4.2",
        "clause": "5.4.2",
        "clauseTitle": "办公生活区卫生",
        "content": "办公及生活区域应保持卫生，电气线路布置规范，严禁在用电设备附近摆放液体容器或易燃物。",
        "category": "文明施工",
        "keywords": ["液体", "水瓶", "水杯", "易燃物", "用电设备", "插排"]
      }
    ]
  },
  {
    "id": "G-008",
    "type": "general",
    "documentName": "脚手架与临边洞口安全管理规范（演示）",
    "documentCode": "DEMO-G-008",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "脚手架",
    "clauses": [
      {
        "id": "G-008-6.1.1",
        "clause": "6.1.1",
        "clauseTitle": "临边防护",
        "content": "无防护的楼层边、屋面临边、基坑边等临边位置必须设置防护栏杆，栏杆高度不低于 1.2m。",
        "category": "临边洞口",
        "keywords": ["临边", "防护栏杆", "楼层边", "护栏"]
      },
      {
        "id": "G-008-6.1.3",
        "clause": "6.1.3",
        "clauseTitle": "洞口防护",
        "content": "电梯井口、楼梯口、预留洞口等必须设置盖板、防护网等防坠落措施。",
        "category": "临边洞口",
        "keywords": ["洞口", "盖板", "防护", "预留洞口"]
      },
      {
        "id": "G-008-7.1.2",
        "clause": "7.1.2",
        "clauseTitle": "脚手架搭设质量",
        "content": "脚手架应按照专项方案搭设，立杆、横杆、剪刀撑连接牢固，作业层脚手板满铺并固定。",
        "category": "脚手架",
        "keywords": ["脚手架", "脚手板", "剪刀撑", "搭设", "满铺"]
      },
      {
        "id": "G-008-7.2.3",
        "clause": "7.2.3",
        "clauseTitle": "架体荷载控制",
        "content": "脚手架使用荷载不得超限，严禁在架体上集中堆放材料或工具。",
        "category": "脚手架",
        "keywords": ["脚手架", "荷载", "超限", "堆放"]
      }
    ]
  },
  {
    "id": "G-009",
    "type": "general",
    "documentName": "机械设备与工器具安全防护管理规范（演示）",
    "documentCode": "DEMO-G-009",
    "version": "演示 V1.0",
    "status": "演示数据",
    "updatedAt": "2026-01-10",
    "category": "设备防护",
    "clauses": [
      {
        "id": "G-009-5.1.1",
        "clause": "5.1.1",
        "clauseTitle": "传动防护",
        "content": "机械设备传动、旋转部位应设置固定可靠的防护罩或防护栏杆，防止卷入伤害。",
        "category": "设备防护",
        "keywords": ["防护罩", "传动", "旋转", "防护"]
      },
      {
        "id": "G-009-5.2.2",
        "clause": "5.2.2",
        "clauseTitle": "用电设备接地",
        "content": "电焊机等用电设备金属外壳应可靠接地或接零，一次、二次侧线缆绝缘应完好。",
        "category": "设备防护",
        "keywords": ["接地", "电焊机", "绝缘", "外壳"]
      },
      {
        "id": "G-009-5.3.1",
        "clause": "5.3.1",
        "clauseTitle": "绝缘工器具",
        "content": "绝缘手套、绝缘鞋等工器具应定期检测合格并在有效期内使用。",
        "category": "设备防护",
        "keywords": ["绝缘", "工器具", "检测", "手套", "鞋"]
      },
      {
        "id": "G-009-6.1.2",
        "clause": "6.1.2",
        "clauseTitle": "急停与持证",
        "content": "机械设备应设置紧急停止装置，操作人员应持证上岗并经过安全培训。",
        "category": "设备防护",
        "keywords": ["急停", "机械", "持证", "培训"]
      }
    ]
  }
]
