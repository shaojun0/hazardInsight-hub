# ============================================================
# 核电工程隐患智能识别与定级系统 - 环境变量示例
# 复制为 .env 并填写。识别前必须配置真实模型；未配置时返回配置错误。
# ============================================================

# 多模态大模型 API（OpenAI 兼容格式，默认适配 DeepSeek）
# Base URL 可填 https://api.deepseek.com 或 https://api.deepseek.com/v1（无需带 /chat/completions）
MULTIMODAL_API_BASE_URL=https://api.deepseek.com/v1
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=deepseek-v4-flash-vision-exp

# 服务端口（可选，默认 3001）
PORT=3001

# GitHub OAuth 2.0 登录（OAuth App，必配；未配置时系统保持锁定）
# 开发环境 OAuth App Homepage URL: http://localhost:5175
# Authorization callback URL: http://localhost:5175/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=请替换为至少32字符的高强度随机字符串
APP_BASE_URL=http://localhost:5175
# 可选；不填时自动使用 APP_BASE_URL + /api/auth/github/callback
GITHUB_OAUTH_CALLBACK_URL=
